pipeline {
  agent any
  options { timestamps() }
  parameters {
    choice(name: 'ENV', choices: ['dev','test','prod'], description: 'Target environment')
    string(name: 'NAMESPACE', defaultValue: 'dev', description: 'K8s namespace')
    string(name: 'RELEASE', defaultValue: 'kafka', description: 'Helm release for Kafka only')
    string(name: 'CHART_PATH', defaultValue: 'charts/kafka', description: 'Path to Kafka chart')
    booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Helm --dry-run --debug')
  }
  environment {
    KUBECONFIG = "$WORKSPACE/.kube/config"
  }
  stages {
    stage('Prepare kubeconfig') {
      steps {
        withCredentials([file(credentialsId: 'KUBECONFIG_CRED', variable: 'KCFG')]) {
          sh 'mkdir -p $WORKSPACE/.kube && cp "$KCFG" "$KUBECONFIG" && chmod 600 "$KUBECONFIG"'
          sh 'kubectl version --client && kubectl config get-contexts || true'
        }
      }
    }
    stage('Helm deps') {
      steps { sh 'helm version' }
    }
    stage('Deploy/Upgrade Kafka (values-ENV)') {
      steps {
        script {
          def vals = "${params.CHART_PATH}/values-${params.ENV}.yaml"
          def cmd = '''helm upgrade --install ${RELEASE} ${CHART_PATH} \
            -n ${NAMESPACE} \
            -f ${VALS}'''
          if (params.DRY_RUN) { cmd += ' --dry-run --debug' }
          sh """
            VALS=${vals}
            if [ ! -f "$VALS" ]; then VALS=${params.CHART_PATH}/values.yaml; fi
            ${cmd}
          """
        }
      }
    }
  }
}
